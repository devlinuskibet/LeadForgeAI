# LeadForgeAI Environment Configuration Template

PROJECT_NAME=LeadForgeAI
VERSION=0.9.0
ENVIRONMENT=development

# Database & Redis Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/leadforge
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
SECRET_KEY=supersecretkey-change-this-in-production-leadforgeai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Delivery Configuration
DEFAULT_SENDER_EMAIL=outreach@leadforge.ai
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Discovery Engine API Keys
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# AI & LLM Copilot Configuration
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000
OPENAI_API_KEY=your_openai_api_key_here
